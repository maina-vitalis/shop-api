<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>eshop — Reset Your Password</title>
    <style>
        /* Reset */
        body, table, td, a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table, td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
        }

        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            height: 100% !important;
            background-color: #f4f6f8;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f4f6f8;
            padding: 24px 0;
        }

        .email-content {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(20, 30, 50, 0.08);
        }

        .email-header {
            padding: 20px 28px;
            text-align: left;
            border-bottom: 1px solid #eef1f4;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand img {
            height: 36px;
            width: auto;
            display: block;
        }

        .brand .company {
            font-weight: 600;
            color: #102a43;
            font-size: 18px;
        }

        .email-body {
            padding: 28px;
            color: #0f1724;
        }

        .greeting {
            font-size: 16px;
            margin: 0 0 8px 0;
        }

        .lead {
            font-size: 14px;
            color: #334155;
            margin: 0 0 18px 0;
            line-height: 1.45;
        }

        .reset-card {
            background: linear-gradient(180deg, #fffbfb, #fff7f7);
            border: 1px solid #fee2e2;
            padding: 20px;
            border-radius: 8px;
            margin: 18px 0;
        }

        .reset-info {
            font-size: 13px;
            color: #475569;
            margin: 0 0 12px 0;
        }

        .btn-wrap {
            text-align: center;
            margin: 18px 0;
        }

        .btn {
            background: #0b69ff;
            color: #fff;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 8px;
            display: inline-block;
            font-weight: 600;
            font-size: 15px;
        }

        .btn:hover {
            background: #0952cc;
        }

        .alert {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            padding: 14px 16px;
            margin: 18px 0;
            border-radius: 4px;
        }

        .alert-title {
            font-weight: 600;
            color: #991b1b;
            margin: 0 0 4px 0;
            font-size: 13px;
        }

        .alert-text {
            color: #b91c1c;
            font-size: 13px;
            margin: 0;
        }

        .muted {
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

        .footer {
            padding: 18px 28px;
            font-size: 12px;
            color: #94a3b8;
            border-top: 1px solid #eef1f4;
        }

        a.inline-link {
            color: #0b69ff;
            text-decoration: none;
        }

        a.inline-link:hover {
            text-decoration: underline;
        }

        .url-fallback {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 12px;
            border-radius: 6px;
            margin: 12px 0;
            word-break: break-all;
            font-size: 12px;
            color: #475569;
        }

        /* Responsive */
        @media (max-width: 420px) {
            .email-content {
                margin: 0 12px;
            }

            .btn {
                padding: 12px 24px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
<div class="email-wrapper">
    <article class="email-content" aria-roledescription="email">
        <div class="email-header">
            <div class="brand">
                <div class="company">eshop</div>
            </div>
        </div>

        <div class="email-body">
            <p class="lead">We received a request to reset the password for your eshop account. Click the button below
                to create a new password.</p>

            <div class="btn-wrap">
                <a class="btn" href="<%= resetUrl; %>" target="_blank" rel="noopener">Reset Password</a>
            </div>

            <div class="reset-card">
                <p class="reset-info"><strong>This link will expire in <%= expiry || '1 hour'; %>.</strong></p>
                <p class="reset-info" style="margin:0">For your security, this password reset link can only be used
                    once. If you need to reset your password again, please request a new link.</p>
            </div>

            <div class="alert">
                <p class="alert-title">⚠️ Didn't request this?</p>
                <p class="alert-text">If you didn't request a password reset, please ignore this email or contact our
                    support team if you have concerns about your account security.</p>
            </div>

            <p class="muted">If the button above doesn't work, copy and paste this URL into your browser:</p>
            <div class="url-fallback">
                <%= resetUrl; %>
            </div>

            <hr style="border:none;border-top:1px solid #eef1f4;margin:18px 0">
            <p style="font-size:13px;color:#64748b;margin:0">Need help? Reply to this email or visit our <a
                        class="inline-link" href="mailto:mainavitalis65@gmail.com">support</a>.</p>
        </div>

        <div class="footer">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
                <div>&copy; <%= new Date().getFullYear(); %> <strong>eshop</strong>. All rights reserved.</div>
                <div style="color:#9aa7c0">Questions? <a class="inline-link"
                                                         href="mailto:mainavitalis65@gmail.com">mainavitalis65@gmail.com</a>
                </div>
            </div>
        </div>
</div>
</div>

<!-- Plain-text fallback for some clients -->
<div style="display:none;white-space:nowrap;font:15px/1px monospace;color:#f4f6f8">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp;
</div>
</body>
</html>
