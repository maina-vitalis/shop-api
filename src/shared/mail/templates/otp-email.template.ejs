<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>eshop — Your OTP</title>
    <style>
      /* Reset */
      body, table, td, a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }

      img {
        -ms-interpolation-mode: bicubic;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        height: 100% !important;
        background-color: #f4f6f8;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
      }

      .email-wrapper {
        width: 100%;
        background-color: #f4f6f8;
        padding: 24px 0;
      }

      .email-content {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(20, 30, 50, 0.08);
      }

      .email-header {
        padding: 20px 28px;
        text-align: left;
        border-bottom: 1px solid #eef1f4;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand img {
        height: 36px;
        width: auto;
        display: block;
      }

      .brand .company {
        font-weight: 600;
        color: #102a43;
        font-size: 18px;
      }

      .email-body {
        padding: 28px;
        color: #0f1724;
      }

      .greeting {
        font-size: 16px;
        margin: 0 0 8px 0;
      }

      .lead {
        font-size: 14px;
        color: #334155;
        margin: 0 0 18px 0;
        line-height: 1.45;
      }

      .otp-card {
        background: linear-gradient(180deg, #fbfdff, #f7fbff);
        border: 1px dashed #e6eef8;
        padding: 18px;
        border-radius: 8px;
        text-align: center;
        margin: 12px 0 18px 0;
      }

      .otp-code {
        font-size: 32px;
        letter-spacing: 6px;
        font-weight: 700;
        color: #0b69ff;
        margin: 4px 0;
      }

      .otp-note {
        font-size: 13px;
        color: #475569;
        margin: 6px 0 0 0;
      }

      .btn-wrap {
        text-align: center;
        margin: 18px 0;
      }

      .btn {
        background: #0b69ff;
        color: #fff;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 8px;
        display: inline-block;
        font-weight: 600;
      }

      .muted {
        color: #64748b;
        font-size: 12px;
      }

      .footer {
        padding: 18px 28px;
        font-size: 12px;
        color: #94a3b8;
        border-top: 1px solid #eef1f4;
      }

      a.inline-link {
        color: #0b69ff;
        text-decoration: none;
      }

      /* Responsive */
      @media (max-width: 420px) {
        .email-content {
          margin: 0 12px;
        }

        .otp-code {
          font-size: 28px;
          letter-spacing: 4px;
        }
      }
    </style>
</head>
<body>
<div class="email-wrapper">
    <article class="email-content" aria-roledescription="email">
        <div class="email-header">
            <div class="brand">
                <div class="company">eshop</div>
            </div>
        </div>

        <div class="email-body">
            <p class="greeting">Hi <%= name ? name : 'there' %>,</p>
            <p class="lead">Use the one-time passcode (OTP) below to complete your sign-in. For your security, this code
                will expire in <strong><%= expiry || '10 minutes' %></strong>.</p>

            <section class="otp-card" aria-label="One time passcode">
                <div class="otp-code" data-otp><%= OTP %></div>
                <div class="otp-note">Enter this code where requested — do not share it with anyone.</div>
            </section>

            <div class="btn-wrap">
                <% if (typeof verifyUrl !== 'undefined' && verifyUrl) { %>
                    <a class="btn" href="<%= verifyUrl %>" target="_blank" rel="noopener">Verify & Sign in</a>
                <% } else { %>
                    <span class="muted">If a button is not available, copy the code above into the app to continue.</span>
                <% } %>
            </div>


            <hr style="border:none;border-top:1px solid #eef1f4;margin:18px 0">
            <p style="font-size:13px;color:#64748b;margin:0">Need help? Reply to this email or visit our <a
                        class="inline-link" href="mailto: mainavitalis65@gmail.com">support</a>.</p>
        </div>

        <div class="footer">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
                <div>&copy; <%= new Date().getFullYear() %> <strong>eshop</strong>. All rights
                    reserved.
                </div>
                <div style="color:#9aa7c0">If you received this in error, please contact us: <a class="inline-link"
                                                                                                href="mailto: mainavitalis65@gmail.com">mainavitalis65@gmail.com</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Plain-text fallback for some clients -->
<div style="display:none;white-space:nowrap;font:15px/1px monospace;color:#f4f6f8">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp;
</div>
</body>
</html>
