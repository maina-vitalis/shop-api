generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String?

  buyerProfile  BuyerProfile?
  vendorProfile VendorProfile?
  adminProfile  AdminProfile?

  role Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id        String   @id @default(uuid())
  role      Roles    @unique @default(CUSTOMER)
  user      User[]
  createdAt DateTime @default(now())
}

model BuyerProfile {
  id      String  @id @default(uuid())
  avatar  String?
  phone   String?
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model VendorProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  store       Store[]
  description String?
  isVerified  Boolean @default(false)
  KYCUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  department  String // e.g., "Finance", "Compliance"
  accessLevel Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Store {
  id             String       @id @default(uuid())
  storeName      String
  registeredName String?
  description    String
  businessType   BusinessType

  status StoreStatus @default(ONBOARDING)

  idDocumentUrl String?
  taxDocument   String?

  bankAccountNumber String?
  routingNumber     String?

  logoUrl    String?
  bannerUrl  String?
  isVerified Boolean @default(false)

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id])
  products        Product[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

//products
model Product {
  id                String        @id @default(uuid())
  name              String
  shortDescription  String?       @db.VarChar(160)
  description       String        @db.Text
  sku               String?
  barcode           String?
  category          String
  brand             String?
  tags              String[]      @default([])
  status            ProductStatus @default(DRAFT)
  images            Json          @default("[]")
  price             Decimal       @db.Decimal(10, 2)
  compareAtPrice    Decimal?      @db.Decimal(10, 2)
  costPerItem       Decimal?      @db.Decimal(10, 2)
  stock             Int?
  lowStockThreshold Int?
  trackInventory    Boolean       @default(false)
  requiresShipping  Boolean       @default(true)
  weight            Decimal?      @db.Decimal(10, 3)
  weightUnit        WeightUnit    @default(KG)
  length            Decimal?      @db.Decimal(10, 2)
  width             Decimal?      @db.Decimal(10, 2)
  height            Decimal?      @db.Decimal(10, 2)
  dimensionUnit     DimensionUnit @default(CM)
  variantOptions    Json          @default("[]")
  seoTitle          String?       @db.VarChar(70)
  seoDescription    String?       @db.VarChar(160)
  seoSlug           String?
  isFeatured        Boolean       @default(false)
  isDigital         Boolean       @default(false)
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([storeId, sku])
  @@index([storeId, status])
  @@index([category])
}

enum Roles {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum WeightUnit {
  KG
  G
  LB
  OZ
}

enum DimensionUnit {
  CM
  IN
}

enum StoreStatus {
  ONBOARDING
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BusinessType {
  Individual
  LLC
  Corp
}
